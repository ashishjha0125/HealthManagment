# ============================================
# NutriVision AI - Environment Variables
# ============================================

# App Configuration
VITE_APP_NAME=NutriVision AI
VITE_APP_VERSION=1.0.0

# TensorFlow Model Configuration
VITE_TF_MODEL_URL=https://tfhub.dev/google/tfjs-model/imagenet/mobilenet_v2_100_224/classification/3/default/1
VITE_TF_INPUT_SIZE=224

# Daily Calorie Goals (defaults)
VITE_DEFAULT_CALORIE_GOAL=2000
VITE_DEFAULT_PROTEIN_GOAL=50
VITE_DEFAULT_CARBS_GOAL=250
VITE_DEFAULT_FAT_GOAL=65
